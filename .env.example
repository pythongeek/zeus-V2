# Zeus Slot — environment configuration.
# Copy to ".env" and fill in. ".env" is git-ignored; NEVER commit it.

# ── Required ────────────────────────────────────────────────────
# Session-signing secret. The app REFUSES TO BOOT without it.
# Minimum 32 characters; use 64. Generate one with:
#   openssl rand -hex 32
APP_SECRET=

# ── Server ──────────────────────────────────────────────────────
# Port the API/game server listens on (behind nginx).
PORT=3100
# SQLite database file. Default: ./data/zeus.sqlite
ZEUS_DB_PATH=
NODE_ENV=production

# ── Optional ────────────────────────────────────────────────────
# Telegram bot token for admin alert messages (the chat id itself
# is configured in Admin > System > Alert channels).
TELEGRAM_BOT_TOKEN=
# Legacy fallback alert webhook. The webhook URL is normally set
# in Admin > System > Alert channels; this env var is only read
# by the monitor when the setting is empty.
ZEUS_ALERT_WEBHOOK=
# OAuth sign-ups whose unionId matches this value are promoted to
# admin on first login (legacy Kimi OAuth path only — for local
# accounts, promote by SQL as described in README.md).
OWNER_UNION_ID=
